# Server-only. Paste the full site key here in .env.local, or configure it in Vercel.
TRAVELOS_OPENAI_API_KEY=
TRAVELOS_OPENAI_MODEL=gpt-4o-mini
TRAVELOS_REASONING_MODEL=gpt-4.1-mini
TRAVELOS_FALLBACK_MODEL=gpt-4.1-mini
# Set trueforge only when a reachable harness is configured.
TRAVELOS_ENGINE=openai
TRUEFORGE_BASE_URL=
TRUEFORGE_TOKEN=
TRAVELOS_STATE_SECRET=
TRAVELOS_MCP_TOKEN=
PORT=8787
HOST=127.0.0.1

# Optional production map service overrides; public demo services work without keys.
# TRAVELOS_GEOCODER_URL=https://your-photon-host/api/
# TRAVELOS_WALK_ROUTER_URL=https://your-osrm-host/routed-foot
# TRAVELOS_DRIVE_ROUTER_URL=https://your-osrm-host/routed-car
