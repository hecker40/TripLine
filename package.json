{
  "name": "tripline",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "client": "vite",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsx scripts/check-deployment.ts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "npm run start",
    "harness": "npx --yes @truefoundry/trueforge@0.2.0 --port 8790",
    "harness:setup": "tsx scripts/setup-trueforge.ts",
    "check:llm": "tsx scripts/check-llm.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "openai": "^7.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
