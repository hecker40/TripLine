{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/maps.ts": { "maxDuration": 120 },
    "api/trips/generate.ts": {
      "maxDuration": 120
    },
    "api/runtime.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/plan",
      "destination": "/index.html"
    }
  ]
}
